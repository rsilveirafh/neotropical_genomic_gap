.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Local only: manuscript drafts, journal proofs and working notes
docs/
.planning/
CLAUDE.md

# Python and OS
__pycache__/
*.pyc
.DS_Store
~$*

# Pipeline outputs (regenerated by the scripts)
outputs/
.venv/
